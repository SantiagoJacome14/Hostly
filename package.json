{
  "name": "hostly",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run tests/disponibilidad.test.js",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-hostly \"vitest run tests/reglas.test.js\"",
    "reglas:subir": "firebase deploy --only firestore",
    "publicar": "vite build && firebase deploy --only hosting"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.3"
  }
}
